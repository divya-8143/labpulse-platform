# Server Configuration
PROJECT_NAME="LabPulse Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="temporary-insecure-secret-key-change-in-production-123456789"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./labpulse.db"
# Production Database URL:
# DATABASE_URL="postgresql+asyncpg://labpulse_user:labpulse_password@localhost:5432/labpulse_db"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI / LLM Engine Settings
LLM_PROVIDER="fallback"  # Options: openai, anthropic, ollama, fallback
OPENAI_API_KEY=""
OPENAI_MODEL_NAME="gpt-4o-mini"
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# OCR Settings
TESSERACT_CMD="tesseract"
OCR_CONFIDENCE_THRESHOLD=60.0

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg", "tiff"]

# Medical Compliance & Safety
ENFORCE_STRICT_DISCLAIMER=True
ALLOW_SYNTHETIC_SEEDING=True
